# dbtx platform configuration. Copy to <platform root>/dbtx.conf.
#
# Format: one KEY=VALUE per line. Lines starting with # are comments. A value may be
# wrapped in single or double quotes. Not supported (each is an error): unknown or
# duplicate keys, `export`, ${VAR} interpolation, multi-line values, inline comments.
#
# Precedence, per option: CLI flag > this file > DBTX_* environment variable.

# enabled (default) or disabled. Disabling turns off recording and `dbtx db`.
DB_BACKEND=enabled

# A SQLAlchemy URL. Required while the backend is enabled.
# A relative SQLite path is relative to this file's directory.
DB_URI=sqlite:///.dbtx/dbtx.db

# Postgres (needs `pip install 'dbtx[postgres]'`). Leave the password out to have
# libpq read it from ~/.pgpass, PGPASSFILE, PGPASSWORD or PGSERVICE.
# DB_URI=postgresql+psycopg://dbtx@db.internal:5432/dbtx

# Postgres only: the schema for dbtx's tables (default dbtx). An error with SQLite.
# DB_SCHEMA=dbtx

# The store adapter, by name. Unset (the default): the adapter for DB_URI's backend and
# driver, which is the built-in for SQLite and Postgres. Set it to use an installed
# adapter plugin instead; it must support DB_URI's database and driver.
# DB_ADAPTER=sqlite

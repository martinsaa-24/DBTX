{#- Integrated template "table": a titled, responsive data table.
    Extend it with {% extends "table" %} and override any block below. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ report.title }}{% endblock %}</title>
<style>
  :root { --fg: #1f2328; --muted: #656d76; --line: #d0d7de; --head: #f6f8fa; --bg: #fff; --accent: #0969da; }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #e6edf3; --muted: #8d96a0; --line: #30363d; --head: #161b22; --bg: #0d1117; --accent: #4493f8; }
  }
  body { margin: 0; padding: 32px 16px; background: var(--bg); color: var(--fg);
         font: 14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 960px; margin: 0 auto; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  .meta { color: var(--muted); margin: 0 0 20px; }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  th, td { border-bottom: 1px solid var(--line); padding: 6px 10px; text-align: left; white-space: nowrap; }
  th { background: var(--head); font-weight: 600; }
  {% block style %}{% endblock %}
</style>
</head>
<body>
<main>
  {% block header %}
  <h1>{{ report.title }}</h1>
  <p class="meta">
    {% if report.description %}{{ report.description }}<br>{% endif %}
    {% if report.owner %}Owner: {{ report.owner }} · {% endif %}{{ rows | length }} rows · generated {{ generated_at }}
  </p>
  {% endblock %}
  {% block content %}
  <div class="scroll">
    <table>
      <thead><tr>{% for c in columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for row in rows %}<tr>{% for v in row %}<td>{{ "" if v is none else v }}</td>{% endfor %}</tr>
      {% endfor %}
      </tbody>
      {% block table_footer %}{% endblock %}
    </table>
  </div>
  {% endblock %}
  {% block footer %}{% endblock %}
</main>
</body>
</html>
